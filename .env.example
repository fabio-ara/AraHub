# Placeholders only. Populate locally; never use sibling cloud projects.
APP_MODE=configured
PUBLIC_URL=http://127.0.0.1:8787
# Edge only: exact HTTPS origin of the separately hosted UI.
UI_ORIGIN=
# Full UI base including a GitHub Pages project path and trailing slash.
UI_URL=
ARAHUB_PUBLISHABLE_KEY=
PORT=8787
DATABASE_URL=
# Hosted Edge uses Supabase's injected SUPABASE_DB_URL if DATABASE_URL is absent.
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
MCP_CLIENT_IDS=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ARAHUB_TOKEN_VAULT_KEY=
ARAHUB_TOKEN_VAULT_KEY_ID=v1
# Optional own-status policy; each connection still needs its authenticated receipt.
ARAHUB_OWN_STATUS_POLICY_ENABLED=false
# Optional private material transfer: independent 32-byte key encoded as base64.
ARAHUB_MATERIAL_TRANSFER_KEY=
